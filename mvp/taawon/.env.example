# ── Gemini (Google AI Studio: https://aistudio.google.com/apikey) ──
# Without a key the platform runs in demo mode with realistic fallback AI responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to 1 to force demo mode even when a key exists (useful if the internet is unreliable during a demo)
AI_DEMO_MODE=0

# ── Session secret (any long random string in production) ──
AUTH_SECRET=change-me-to-a-long-random-string

# ── Database ──
# Local: leave empty (uses file:local.db). Production: Turso URL + token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ── Video storage (production on Vercel) ──
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_USE_BLOB=0
